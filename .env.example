# Copy to .env and fill in local values. Generate a secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/business_paddy?schema=public"
BETTER_AUTH_SECRET="PASTE_GENERATED_64_HEX_CHARS_HERE"
BETTER_AUTH_URL="http://localhost:3000"
# Paystack TEST secret key (server-only, never NEXT_PUBLIC_). Get it from
# https://dashboard.paystack.com/#/settings/developers (test mode).
# Leave it unset to run the app without payments; checkout will show guidance.
PAYSTACK_SECRET_KEY="PASTE_SK_TEST_KEY_HERE"
# Resend API key (server-only). Get it from https://resend.com/api-keys.
# Leave it unset to run the app without invitation emails; invites will show guidance.
RESEND_API_KEY="PASTE_RE_KEY_HERE"
# Verified sender for invitation emails, e.g. "Business Paddy <team@yourdomain.com>".
# Until your domain is verified, use "Business Paddy <onboarding@resend.dev>"
# (test address — delivers only to the Resend account owner's email).
RESEND_FROM_EMAIL="Business Paddy <onboarding@resend.dev>"
