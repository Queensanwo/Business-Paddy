generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceMode {
  DEMO
  LIVE
}

enum Role {
  OWNER
  MANAGER
  AGENT
  TRAINEE
}

enum Channel {
  WHATSAPP
  INSTAGRAM
  TIKTOK
  EMAIL
  WEBSITE
  PADDY_CHAT
}

enum ConvStatus {
  NEW
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  FOLLOW_UP
  NEEDS_APPROVAL
  ESCALATED
  RESOLVED
}

enum MessageKind {
  CUSTOMER
  STAFF
  NOTE
  SYSTEM
}

enum ReminderStatus {
  SCHEDULED
  SNOOZED
  COMPLETED
  CANCELLED
}

model Workspace {
  id           String         @id @default(cuid())
  name         String
  industry     String?
  contactEmail String?
  contactPhone String?
  mode         WorkspaceMode  @default(DEMO)
  createdAt    DateTime       @default(now())
  users        User[]
  customers    Customer[]
  conversations Conversation[]
  reminders    Reminder[]
  auditLogs    AuditLog[]
  channels     ChannelAccount[]
}

model User {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  email       String
  role        Role     @default(AGENT)
  createdAt   DateTime @default(now())

  assignedConversations Conversation[] @relation("Assignee")
  assignedReminders     Reminder[]     @relation("ReminderAssignee")
  auditActions          AuditLog[]     @relation("Actor")

  @@unique([workspaceId, email])
}

model Customer {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  contactDetail String?
  createdAt     DateTime @default(now())

  conversations Conversation[]

  @@index([workspaceId])
}

model ChannelAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel           Channel
  providerAccountId String?
  displayName       String?
  // FR43: records whether outbound messages appear in the platform's own inbox (verified per channel, never assumed)
  mirroringVerified Boolean  @default(false)
  mirroringNotes    String?
  createdAt         DateTime @default(now())

  conversations Conversation[]

  @@index([workspaceId, channel])
}

model Conversation {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  channel     Channel
  channelAccountId String?
  channelAccount ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: SetNull)
  status      ConvStatus @default(NEW)
  assigneeId  String?
  assignee    User?      @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  preview     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  messages  Message[]
  reminders Reminder[]

  @@index([workspaceId, status])
  @@index([workspaceId, channel])
}

model Message {
  id          String      @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  kind        MessageKind
  senderName  String
  text        String
  // FR42: provider message ID stored when the reply is sent through an official channel integration
  providerMessageId String? @unique
  createdAt   DateTime  @default(now())

  attachments Attachment[]

  @@index([conversationId, createdAt])
}

model Attachment {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int?
  storageKey String?
  createdAt DateTime @default(now())
}

// Internal staff reminders only. Never sent to customers.
model Reminder {
  id             String         @id @default(cuid())
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  title          String
  assignedToId   String?
  assignedTo     User?          @relation("ReminderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  scheduledAt    DateTime
  timezone       String?
  frequency      String?
  status         ReminderStatus @default(SCHEDULED)
  createdAt      DateTime       @default(now())

  @@index([workspaceId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  workspaceId String
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([workspaceId, createdAt])
}
